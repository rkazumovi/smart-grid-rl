data/processed/

# Trained checkpoints + the RAG index (rebuilt by build_rag_index.py): regenerated
# by the training scripts (see README's "Getting Started"), and .pt/.zip
# checkpoints add up in size fast. Remove this line (or switch to Git LFS) if you
# want the actual trained weights in the repo.
outputs/

# Env files that may hold API keys (ANTHROPIC_API_KEY, etc.)
.env